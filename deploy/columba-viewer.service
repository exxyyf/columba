[Unit]
Description=Columba viewer (DXA gallery)
After=network.target

[Service]
WorkingDirectory=/opt/columba/interface
ExecStart=/usr/bin/node dist/server.js
Environment=PORT=8425
Environment=COLUMBA_PYTHON=/opt/columba/.venv/bin/python
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
